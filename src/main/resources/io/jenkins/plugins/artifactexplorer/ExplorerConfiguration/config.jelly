<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="${%Artifact Explorer}">
    <f:entry field="replaceClassicBrowser" title="${%Replace the classic artifact browser}">
      <f:checkbox default="true"/>
    </f:entry>
    <f:entry field="maxEntries" title="${%Maximum entries per listing}">
      <f:number default="5000" min="1" max="100000"/>
    </f:entry>
  </f:section>
</j:jelly>
